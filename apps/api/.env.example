# ===========================
# apps/api — NestJS Backend
# ===========================

DATABASE_URL="postgresql://antigravity:antigravity@localhost:5434/antigravity"
REDIS_URL="redis://localhost:6379"

BACKEND_JWT_SECRET="change-me-super-secret-jwt-key"
REFRESH_TOKEN_SECRET="change-me-refresh-token-secret"

# Shared with Next.js (verify exchange request)
AUTH_SECRET="change-me-authjs-secret"

# AWS
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="ap-southeast-1"
S3_BUCKET_NAME="antigravity-raw"
S3_PROCESSED_BUCKET="antigravity-processed"
CLOUDFRONT_DOMAIN="cdn.antigravity.app"

# Google (Android OAuth verify)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Firebase Admin (JSON string)
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'

# Internal API (Lambda → NestJS callback)
INTERNAL_API_SECRET="change-me-internal-secret"

# App
PORT=4000
NODE_ENV=development
WEB_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:4000"

# Mail (SMTP — dùng bởi verifyEmail flow, tất cả optional; để trống → gửi thất bại im lặng)
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM="Antigravity <noreply@antigravity.app>"

# Login rate-limit (tất cả optional, đơn vị giây)
LOGIN_MAX_ATTEMPTS=5
LOGIN_FAIL_WINDOW_SEC=900
LOGIN_LOCK_SEC=900

# Trần tạo pin theo phút (XH-4b) — optional, mặc định 10.
# Đây là giới hạn chống lạm dụng DUY NHẤT trên đường tạo pin sau khi trần
# 20 pin/ngày bị bỏ (XH-QĐ-8). Giá trị rác (`=abc`) chết lúc BOOT, không
# lặng lẽ tắt trần. Cửa sổ cố định 60 giây, không cấu hình được.
PIN_CREATE_PER_MIN=10
