# ===========================
# apps/api — NestJS Backend
# ===========================

DATABASE_URL="postgresql://postgres:password@localhost:5432/antigravity_dev"
REDIS_URL="redis://localhost:6379"

BACKEND_JWT_SECRET="change-me-super-secret-jwt-key"
REFRESH_TOKEN_SECRET="change-me-refresh-token-secret"

# Shared with Next.js (verify exchange request)
AUTH_SECRET="change-me-authjs-secret"

# AWS
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="ap-southeast-1"
S3_BUCKET_NAME="antigravity-raw"
S3_PROCESSED_BUCKET="antigravity-processed"
CLOUDFRONT_DOMAIN="cdn.antigravity.app"

# Google (Android OAuth verify)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Firebase Admin (JSON string)
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'

# Internal API (Lambda → NestJS callback)
INTERNAL_API_SECRET="change-me-internal-secret"

# App
PORT=4000
NODE_ENV=development
WEB_URL="http://localhost:3000"
