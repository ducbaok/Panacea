{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "codegen", "^codegen"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "codegen": {
      "inputs": ["codegen.ts", "**/*.graphql", "../../apps/api/schema.graphql"],
      "outputs": ["src/generated/**", "lib/gql/**"]
    }
  }
}
